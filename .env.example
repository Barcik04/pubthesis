# Baza danych PostgreSQL (kontener)
POSTGRES_DB=services_management_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Polaczenie aplikacji z baza (wartosci musza odpowiadac sekcji powyzej)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/services_management_db
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change_me

# Poczta (SMTP), haslo aplikacji wygenerowane w ustawieniach konta
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password


# Stripe (tryb testowy), klucze z panelu Stripe i ze Stripe CLI
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret